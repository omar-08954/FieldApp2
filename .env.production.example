# Domain name must already point to this server (A/AAAA record).
DOMAIN=fieldapp.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=fieldapp
POSTGRES_USER=fieldapp
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
REDIS_URL=redis://redis:6379/0
JWT_SECRET=generate-a-long-random-secret
INITIAL_ADMIN_USERNAME=change-this-admin-username
INITIAL_ADMIN_PASSWORD=change-this-admin-password
INITIAL_ADMIN_NAME=change-this-admin-name
DEFAULT_TECHNICIAN_PASSWORD=change-this-technician-password
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_ORIGINS=https://fieldapp.example.com

AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-your-openai-key
AI_MODEL=gpt-4.1-mini
LOGS_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
MAX_UPLOAD_BYTES=26214400

# Supabase Storage for durable report images.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ضع مفتاح Supabase Service Role الخاص بك هنا
SUPABASE_REPORTS_BUCKET=fieldapp-reports
