# Domain name must already point to this server (A/AAAA record).
DOMAIN=fieldapp.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=fieldapp
POSTGRES_USER=fieldapp
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://fieldapp:replace-with-a-long-random-password@db:5432/fieldapp
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_ORIGINS=https://fieldapp.example.com

AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
LOGS_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Cloudflare R2 for durable report images. Obtain an S3 API token scoped only to this bucket.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fieldapp-reports
