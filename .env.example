# PostgreSQL (Docker compose provides compatible defaults)
POSTGRES_DB=fieldapp
POSTGRES_USER=fieldapp
POSTGRES_PASSWORD=change-me-in-production
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password
INITIAL_ADMIN_NAME=مسؤول النظام
DATABASE_URL=postgresql+psycopg://fieldapp:change-me-in-production@db:5432/fieldapp
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_ORIGINS=http://localhost
# AI assistant (optional OpenAI-compatible provider; never expose this key to Next.js)
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
LOGS_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# Cloudflare R2 for durable daily-report images (leave blank for local filesystem).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fieldapp-reports
