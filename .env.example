# PostgreSQL (Docker compose provides compatible defaults)
POSTGRES_DB=fieldapp
POSTGRES_USER=fieldapp
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://fieldapp:change-me-in-production@db:5432/fieldapp
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_ORIGINS=http://localhost
# AI assistant (optional OpenAI-compatible provider; never expose this key to Next.js)
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
LOGS_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
